# ─── Azure AD (App Registration) ─────────────────────────────────────────────
# Create at: https://portal.azure.com → Azure Active Directory → App registrations
CLIENT_ID=your-azure-ad-client-id
TENANT_ID=your-azure-ad-tenant-id
CLIENT_SECRET=your-azure-ad-client-secret

# ─── Azure Table Storage ──────────────────────────────────────────────────────
# Create at: https://portal.azure.com → Storage accounts → Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ─── Azure Maps ───────────────────────────────────────────────────────────────
# Create at: https://portal.azure.com → Azure Maps → Authentication → Primary Key
AZURE_MAPS_KEY=your-azure-maps-key

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8081

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL (ngrok tunnel for local Teams testing, or production URL)
FRONTEND_URL=http://localhost:3000
