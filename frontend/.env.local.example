# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
AZURE_AD_CLIENT_ID=b1068ac3-9c69-4b97-92b6-2a907d554a0d
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=c8e999a5-7cc1-4063-a8ce-791ed474039f

# ── Backend API ───────────────────────────────────────────────────────────────
# Points to the Express backend (ClientApp/backend)
NEXT_PUBLIC_API_URL=http://localhost:8081

# ── Azure Maps ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AZURE_MAPS_KEY=your-azure-maps-key-here
